# In Vercel Services, BACKEND_URL is automatically injected via the service binding. Do not set manually on Vercel.
# BACKEND_URL=http://backend.internal:4000

# Client-side API URL fallback (optional on Vercel as /api/(.*) rewrites to backend on the same domain)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BRAND_NAME="KHADIJA-TUL-QUBRAH BY Meer&Mus"
NEXT_PUBLIC_BRAND_PRIMARY_DISPLAY="KHADIJA-TUL-QUBRAH"
NEXT_PUBLIC_BRAND_SIGNATURE="BY Meer&Mus"
