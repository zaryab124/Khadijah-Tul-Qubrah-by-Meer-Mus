datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  DESIGNER
  PRODUCTION
  CUSTOMER
}

enum CustomRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  DESIGN_REVIEW
  CLARIFICATION_REQUESTED
  QUOTE_PREPARATION
  QUOTE_SENT
  REVISION_REQUESTED
  QUOTE_ACCEPTED
  CONVERTED_TO_ORDER
  CANCELLED
  REJECTED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  REVISION_REQUESTED
  ACCEPTED
  EXPIRED
  SUPERSEDED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  ON_HOLD
}

enum ProductionStatus {
  NEW
  CUTTING
  STITCHING
  CRAFTING
  FINISHING
  QUALITY_CHECK
  READY
  COMPLETED
  ON_HOLD
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  CUSTOM_REQUEST
  QUOTE_SENT
  NEGOTIATION
  CONVERTED
  LOST
  CLOSED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum NotificationEventType {
  NEW_LEAD
  LEAD_ASSIGNED
  CUSTOM_REQUEST_SUBMITTED
  DESIGNER_ASSIGNED
  QUOTATION_READY
  QUOTATION_REVISION_REQUESTED
  QUOTATION_ACCEPTED
  PAYMENT_SUCCESSFUL
  PRODUCTION_STARTED
  PRODUCTION_UPDATE
  QUALITY_CHECK
  ORDER_SHIPPED
  ORDER_DELIVERED
}

// ==========================================
// IDENTITY & USERS
// ==========================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  phoneNumber      String?   @unique @map("phone_number")
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  role             UserRole  @default(CUSTOMER)
  isActive         Boolean   @default(true) @map("is_active")
  isVerified       Boolean   @default(false) @map("is_verified")
  avatarUrl        String?   @map("avatar_url")
  refreshTokenHash     String?   @map("refresh_token_hash")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  lastLoginAt          DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Profile extensions
  customerProfile CustomerProfile?
  agentProfile    AgentProfile?

  // Relations as Customer
  customRequestsAsCustomer CustomDesignRequest[] @relation("CustomerCustomRequests")
  ordersAsCustomer         Order[]               @relation("CustomerOrders")
  addresses                Address[]

  // Relations as Staff
  assignedRequestsAsAgent    CustomDesignRequest[] @relation("AgentCustomRequests")
  assignedRequestsAsDesigner CustomDesignRequest[] @relation("DesignerCustomRequests")
  createdQuotations          Quotation[]           @relation("DesignerQuotations")
  assignedLeads              Lead[]                @relation("AgentLeads")
  leadActivities             LeadActivity[]        @relation("AgentLeadActivities")
  productionUpdatesRecorded  ProductionUpdate[]    @relation("RecordedProductionUpdates")
  qualityChecksInspected     QualityCheck[]        @relation("InspectorQualityChecks")
  productionJobsManaged      ProductionJob[]       @relation("ManagerProductionJobs")
  uploadedDesignFiles        DesignFile[]          @relation("UserDesignFiles")
  notifications              Notification[]        @relation("UserNotifications")
  notificationPreference     NotificationPreference? @relation("UserNotificationPreferences")
  auditLogs                  AuditLog[]            @relation("ActorAuditLogs")

  @@index([role, createdAt])
  @@map("users")
}




model CustomerProfile {
  userId               String   @id @map("user_id")
  preferredCurrency    String   @default("PKR") @map("preferred_currency")
  notes                String?
  standardMeasurements Json?    @map("standard_measurements")
  originCampaignId     String?  @map("origin_campaign_id")
  originLeadId         String?  @map("origin_lead_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  originCampaign Campaign? @relation(fields: [originCampaignId], references: [id], onDelete: SetNull)
  originLead     Lead?     @relation("LeadCustomers", fields: [originLeadId], references: [id], onDelete: SetNull)

  @@map("customer_profiles")
}

model AgentProfile {
  userId             String   @id @map("user_id")
  department         String   @default("SALES")
  maxActiveLeads     Int      @default(30) @map("max_active_leads")
  currentActiveLeads Int      @default(0) @map("current_active_leads")
  commissionRate     Decimal  @default(0.00) @map("commission_rate") @db.Decimal(5, 2)
  isAvailable        Boolean  @default(true) @map("is_available")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

// ==========================================
// BRAND & ASSETS
// ==========================================

model Brand {
  id                 String   @id @default(uuid())
  officialName       String   @default("KHADIJA-TUL-QUBRAH BY Meer&Mus") @map("official_name")
  primaryDisplay     String   @default("KHADIJA-TUL-QUBRAH") @map("primary_display")
  secondarySignature String   @default("BY Meer&Mus") @map("secondary_signature")
  primaryColor       String   @default("#072A20") @map("primary_color")
  secondaryColor     String   @default("#C5A059") @map("secondary_color")
  accentColor        String   @default("#FCFBF7") @map("accent_color")
  supportEmail       String?  @map("support_email")
  supportPhone       String?  @map("support_phone")
  whatsappNumber     String?  @map("whatsapp_number")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  assets BrandAsset[]

  @@map("brand")
}

model BrandAsset {
  id            String   @id @default(uuid())
  brandId       String   @map("brand_id")
  assetType     String   @map("asset_type") // LOGO_PRIMARY, LOGO_ON_VELVET, FAVICON, BANNER
  storageKey    String   @map("storage_key")
  cdnUrl        String   @map("cdn_url")
  mimeType      String   @map("mime_type")
  fileSizeBytes BigInt   @map("file_size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_assets")
}

// ==========================================
// CATALOG, FABRIC & CRAFTSMANSHIP
// ==========================================

model Category {
  id             String   @id @default(uuid())
  parentId       String?  @map("parent_id")
  name           String
  slug           String   @unique
  description    String?
  bannerImageUrl String?  @map("banner_image_url")
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent     Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]  @relation("CategoryHierarchy")
  products   Product[]
  sizeCharts SizeChart[]

  @@map("categories")
}

model Colour {
  id          String   @id @default(uuid())
  name        String
  hexCode     String   @map("hex_code")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  variants       ProductVariant[]
  customRequests CustomDesignRequest[]

  @@map("colours")
}

model Size {
  id        String   @id @default(uuid())
  name      String // XS, S, M, L, XL, Custom
  code      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  variants       ProductVariant[]
  customRequests CustomDesignRequest[]

  @@map("sizes")
}

model SizeChart {
  id                 String   @id @default(uuid())
  categoryId         String?  @map("category_id")
  title              String
  unit               String   @default("INCHES")
  measurementsMatrix Json     @map("measurements_matrix")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("size_charts")
}

model Fabric {
  id               String   @id @default(uuid())
  name             String
  description      String?
  swatchImageUrl   String?  @map("swatch_image_url")
  basePricePerMeter Decimal  @default(0.00) @map("base_price_per_meter") @db.Decimal(10, 2)
  isAvailable      Boolean  @default(true) @map("is_available")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customRequests CustomDesignRequest[]

  @@map("fabrics")
}

model CraftOption {
  id             String   @id @default(uuid())
  name           String
  craftCategory  String?  @map("craft_category") // EMBROIDERY, HANDWORK, PRINTING, APPLIQUE
  description    String?
  sampleImageUrl String?  @map("sample_image_url")
  estimatedDays  Int      @default(7) @map("estimated_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("craft_options")
}

model Product {
  id             String   @id @default(uuid())
  categoryId     String?  @map("category_id")
  name           String
  slug           String   @unique
  sku            String   @unique
  description    String?
  basePrice      Decimal  @map("base_price") @db.Decimal(12, 2)
  isCustomizable Boolean  @default(true) @map("is_customizable")
  isActive       Boolean  @default(true) @map("is_active")
  sizeChartId    String?  @map("size_chart_id")
  tags           String[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeChart      SizeChart?            @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  customRequests CustomDesignRequest[]

  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  storageKey   String   @map("storage_key")
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  colourId        String?  @map("colour_id")
  sizeId          String?  @map("size_id")
  sku             String   @unique
  stockQuantity   Int      @default(0) @map("stock_quantity")
  priceAdjustment Decimal  @default(0.00) @map("price_adjustment") @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour     Colour?     @relation(fields: [colourId], references: [id], onDelete: Restrict)
  size       Size?       @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@map("product_variants")
}

// ==========================================
// BESPOKE CUSTOM DESIGN & DESIGN FILES
// ==========================================

model CustomDesignRequest {
  id                  String              @id @default(uuid())
  requestNumber       String              @unique @map("request_number")
  customerId          String              @map("customer_id")
  referencedProductId String?             @map("referenced_product_id")
  assignedAgentId     String?             @map("assigned_agent_id")
  assignedDesignerId  String?             @map("assigned_designer_id")
  status              CustomRequestStatus @default(DRAFT)

  // Custom Choices
  colourPreference   String?  @map("colour_preference")
  colourId           String?  @map("colour_id")
  fabricId           String?  @map("fabric_id")
  craftOptionIds     String[] @default([]) @map("craft_option_ids")

  // Sizing & Measurements
  sizingMode            String   @default("STANDARD") @map("sizing_mode")
  standardSizeId        String?  @map("standard_size_id")
  measurementTemplateId String?  @map("measurement_template_id")
  customMeasurements    Json?    @map("custom_measurements")

  designNotes          String?   @map("design_notes")
  clarificationNotes   String?   @map("clarification_notes")
  customerBudget       Decimal?  @map("customer_budget") @db.Decimal(12, 2)
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  originCampaignId     String?              @map("origin_campaign_id")
  originLeadId         String?              @map("origin_lead_id")

  customer            User                 @relation("CustomerCustomRequests", fields: [customerId], references: [id], onDelete: Restrict)
  referencedProduct   Product?             @relation(fields: [referencedProductId], references: [id], onDelete: SetNull)
  assignedAgent       User?                @relation("AgentCustomRequests", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedDesigner    User?                @relation("DesignerCustomRequests", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  colour              Colour?              @relation(fields: [colourId], references: [id], onDelete: SetNull)
  fabric              Fabric?              @relation(fields: [fabricId], references: [id], onDelete: SetNull)
  standardSize        Size?                @relation(fields: [standardSizeId], references: [id], onDelete: SetNull)
  measurementTemplate MeasurementTemplate? @relation(fields: [measurementTemplateId], references: [id], onDelete: SetNull)
  originCampaign       Campaign?            @relation(fields: [originCampaignId], references: [id], onDelete: SetNull)
  originLead           Lead?                @relation("LeadCustomRequests", fields: [originLeadId], references: [id], onDelete: SetNull)

  designFiles DesignFile[]
  quotations  Quotation[]
  orders      Order[]
  orderItems  OrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("custom_design_requests")

}


model MeasurementTemplate {
  id          String   @id @default(uuid())
  title       String
  garmentType String   @map("garment_type")
  description String?
  unit        String   @default("INCHES")
  fields      Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customRequests CustomDesignRequest[]

  @@map("measurement_templates")
}

model DesignFile {
  id              String   @id @default(uuid())
  customRequestId String   @map("custom_request_id")
  uploadedBy      String   @map("uploaded_by")
  fileType        String   @map("file_type")
  storageKey      String   @map("storage_key")
  fileName        String   @map("file_name")
  fileSizeBytes   BigInt   @map("file_size_bytes")
  mimeType        String   @map("mime_type")
  thumbnailKey    String?  @map("thumbnail_key")
  createdAt       DateTime @default(now()) @map("created_at")

  customRequest CustomDesignRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  uploader      User                @relation("UserDesignFiles", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("design_files")
}

// ==========================================
// QUOTATIONS & IMMUTABLE REVISIONS
// ==========================================

model Quotation {
  id                         String          @id @default(uuid())
  customRequestId            String          @map("custom_request_id")
  versionNumber              Int             @map("version_number")
  quoteNumber                String          @unique @map("quote_number")
  createdBy                  String          @map("created_by")
  status                     QuotationStatus @default(DRAFT)
  subtotalAmount             Decimal         @default(0.00) @map("subtotal_amount") @db.Decimal(12, 2)
  customizationFee           Decimal         @default(0.00) @map("customization_fee") @db.Decimal(12, 2)
  deliveryFee                Decimal         @default(0.00) @map("delivery_fee") @db.Decimal(12, 2)
  fabricCost                 Decimal         @default(0.00) @map("fabric_cost") @db.Decimal(12, 2)
  craftsmanshipCost          Decimal         @default(0.00) @map("craftsmanship_cost") @db.Decimal(12, 2)
  stitchingCost              Decimal         @default(0.00) @map("stitching_cost") @db.Decimal(12, 2)
  discountAmount             Decimal         @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount                  Decimal         @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  shippingAmount             Decimal         @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount                Decimal         @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  currency                   String          @default("PKR")
  estimatedMinDays           Int             @default(7) @map("estimated_min_days")
  estimatedMaxDays           Int             @default(21) @map("estimated_max_days")
  estimatedProductionDays    Int             @default(14) @map("estimated_production_days")
  designerNotes              String?         @map("designer_notes")
  customerChangeRequestNotes String?         @map("customer_change_request_notes")
  validUntil                 DateTime        @map("valid_until")
  sentAt                     DateTime?       @map("sent_at")
  acceptedAt                 DateTime?       @map("accepted_at")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  customRequest CustomDesignRequest @relation(fields: [customRequestId], references: [id], onDelete: Restrict)
  designer      User                @relation("DesignerQuotations", fields: [createdBy], references: [id], onDelete: Restrict)
  items         QuotationItem[]
  orders        Order[]

  @@unique([customRequestId, versionNumber])
  @@index([status, createdAt])
  @@map("quotations")
}


model QuotationItem {
  id          String   @id @default(uuid())
  quotationId String   @map("quotation_id")
  itemTitle   String   @map("item_title")
  itemType    String   @map("item_type")
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ==========================================
// ORDERS, ADDRESSES & PAYMENTS
// ==========================================

model Address {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  addressTitle       String?  @default("Home") @map("address_title")
  recipientName      String   @map("recipient_name")
  phoneNumber        String   @map("phone_number")
  addressLine1       String   @map("address_line1")
  addressLine2       String?  @map("address_line2")
  city               String
  stateProvince      String?  @map("state_province")
  postalCode         String?  @map("postal_code")
  country            String   @default("Pakistan")
  isDefaultShipping  Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling   Boolean  @default(false) @map("is_default_billing")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@map("addresses")
}

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique @map("order_number")
  customerId            String        @map("customer_id")
  originCustomRequestId String?       @map("origin_custom_request_id")
  acceptedQuotationId   String?       @map("accepted_quotation_id")
  status                OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  subtotalAmount        Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount        Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount             Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  shippingAmount        Decimal       @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount           Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency              String        @default("PKR")
  shippingAddressId     String?       @map("shipping_address_id")
  billingAddressId      String?       @map("billing_address_id")
  orderNotes            String?       @map("order_notes")
  confirmedAt           DateTime?     @map("confirmed_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancellationReason    String?       @map("cancellation_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  originCampaignId      String?              @map("origin_campaign_id")
  originLeadId          String?              @map("origin_lead_id")

  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  originCustomRequest CustomDesignRequest? @relation(fields: [originCustomRequestId], references: [id], onDelete: SetNull)
  acceptedQuotation   Quotation?           @relation(fields: [acceptedQuotationId], references: [id], onDelete: SetNull)
  shippingAddress     Address?             @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  billingAddress      Address?             @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)
  originCampaign       Campaign?            @relation(fields: [originCampaignId], references: [id], onDelete: SetNull)
  originLead           Lead?                @relation("LeadOrders", fields: [originLeadId], references: [id], onDelete: SetNull)

  orderItems     OrderItem[]
  payments       Payment[]
  productionJobs ProductionJob[]
  shipments      Shipment[]


  @@index([status, createdAt])
  @@index([customerId])
  @@index([originCampaignId])
  @@map("orders")
}


model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productVariantId String?  @map("product_variant_id")
  customRequestId String?  @map("custom_request_id")
  itemTitle       String   @map("item_title")
  sku             String?
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity        Int      @default(1)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  specifications  Json?
  createdAt       DateTime @default(now()) @map("created_at")

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant?      @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  customRequest  CustomDesignRequest? @relation(fields: [customRequestId], references: [id], onDelete: SetNull)
  productionJobs ProductionJob[]

  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @map("order_id")
  transactionReference String        @unique @map("transaction_reference")
  paymentGateway       String        @map("payment_gateway")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("PKR")
  status               PaymentStatus @default(PENDING)
  gatewayResponse      Json?         @map("gateway_response")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("payments")
}

// ==========================================
// PRODUCTION, QUALITY CONTROL & LOGISTICS
// ==========================================

model ProductionJob {
  id                   String           @id @default(uuid())
  jobNumber            String           @unique @map("job_number")
  orderId              String           @map("order_id")
  orderItemId          String           @map("order_item_id")
  status               ProductionStatus @default(NEW)
  progressPercentage   Int              @default(0) @map("progress_percentage")
  assignedManagerId    String?          @map("assigned_manager_id")
  targetCuttingDate    DateTime?        @map("target_cutting_date")
  targetStitchingDate  DateTime?        @map("target_stitching_date")
  targetCraftingDate   DateTime?        @map("target_crafting_date")
  targetCompletionDate DateTime?        @map("target_completion_date")
  actualCompletionDate DateTime?        @map("actual_completion_date")
  productionNotes      String?          @map("production_notes")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  order           Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  assignedManager User?              @relation("ManagerProductionJobs", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  updates         ProductionUpdate[]
  qualityChecks   QualityCheck[]

  @@index([status, targetCompletionDate])
  @@index([actualCompletionDate])
  @@map("production_jobs")
}


model ProductionUpdate {
  id                 String           @id @default(uuid())
  productionJobId    String           @map("production_job_id")
  recordedBy         String           @map("recorded_by")
  stage              ProductionStatus
  progressPercentage Int              @default(0) @map("progress_percentage")
  notes              String?
  photoStorageKeys   String[]         @default([]) @map("photo_storage_keys")
  createdAt          DateTime         @default(now()) @map("created_at")

  productionJob ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  recorder      User          @relation("RecordedProductionUpdates", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@map("production_updates")
}

model QualityCheck {
  id                           String    @id @default(uuid())
  productionJobId              String    @map("production_job_id")
  inspectorId                  String    @map("inspector_id")
  status                       String    @default("PASSED")
  isPassed                     Boolean   @default(false) @map("is_passed")
  notes                        String?
  issues                       String[]  @default([])
  measurementAccuracyVerified  Boolean   @default(false) @map("measurement_accuracy_verified")
  fabricFinishVerified         Boolean   @default(false) @map("fabric_finish_verified")
  embroideryAccuracyVerified   Boolean   @default(false) @map("embroidery_accuracy_verified")
  stitchingDensityVerified     Boolean   @default(false) @map("stitching_density_verified")
  defectNotes                  String?   @map("defect_notes")
  inspectionPhotos             String[]  @default([]) @map("inspection_photos")
  approvedAt                   DateTime? @map("approved_at")
  inspectedAt                  DateTime  @default(now()) @map("inspected_at")

  productionJob ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Restrict)
  inspector     User          @relation("InspectorQualityChecks", fields: [inspectorId], references: [id], onDelete: Restrict)

  @@map("quality_checks")
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  trackingNumber    String    @map("tracking_number")
  courierName       String    @map("courier_name")
  shippingLabelUrl  String?   @map("shipping_label_url")
  status            String    @default("LABEL_CREATED")
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  trackingEvents    Json?     @default("[]") @map("tracking_events")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("shipments")
}

// ==========================================
// CRM, CAMPAIGNS & LEADS
// ==========================================

model Campaign {
  id              String         @id @default(uuid())
  name            String
  title           String?        // Backward compatibility
  platform        String         @default("Website") // Facebook, Instagram, TikTok, WhatsApp, Website, Other
  campaignCode    String         @unique @map("campaign_code")
  utmCampaign     String?        @map("utm_campaign")
  utmSource       String?        @map("utm_source")
  utmMedium       String?        @map("utm_medium")
  budget          Decimal        @default(0.00) @map("budget") @db.Decimal(12, 2)
  allocatedBudget Decimal?       @map("allocated_budget") @db.Decimal(12, 2)
  status          CampaignStatus @default(ACTIVE)
  startDate       DateTime?      @map("start_date")
  endDate         DateTime?      @map("end_date")
  description     String?
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  leads          Lead[]
  orders         Order[]
  customRequests CustomDesignRequest[]
  customers      CustomerProfile[]

  @@map("campaigns")
}

model CampaignPlatform {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("campaign_platforms")
}

model Lead {
  id              String     @id @default(uuid())
  leadNumber      String     @unique @map("lead_number")
  campaignId       String?    @map("campaign_id")
  customerId       String?    @map("customer_id")
  convertedOrderId String?    @map("converted_order_id")
  assignedAgentId  String?    @map("assigned_agent_id")
  leadSource      String     @default("ORGANIC_WEB") @map("lead_source")
  status          LeadStatus @default(NEW)
  priority        String     @default("MEDIUM")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  contactPhone    String     @map("contact_phone")
  contactEmail    String?    @map("contact_email")
  inquiryMessage  String?    @map("inquiry_message")
  estimatedValue  Decimal?   @map("estimated_value") @db.Decimal(12, 2)
  convertedAt     DateTime?  @map("converted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  campaign       Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedAgent  User?                 @relation("AgentLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  customers      CustomerProfile[]     @relation("LeadCustomers")
  customRequests CustomDesignRequest[] @relation("LeadCustomRequests")
  orders         Order[]               @relation("LeadOrders")

  @@index([status, createdAt])
  @@index([leadSource])
  @@index([assignedAgentId])
  @@index([campaignId])
  @@map("leads")
}

model LeadActivity {
  id            String    @id @default(uuid())
  leadId        String    @map("lead_id")
  agentId       String    @map("agent_id")
  activityType  String    @map("activity_type")
  summary       String
  detailedNotes String?   @map("detailed_notes")
  scheduledAt   DateTime? @map("scheduled_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent User @relation("AgentLeadActivities", fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, createdAt])
  @@index([leadId])
  @@map("lead_activities")
}


// ==========================================
// NOTIFICATIONS & AUDIT LOGS
// ==========================================

model Notification {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  title          String
  body           String
  channel        NotificationChannel   @default(IN_APP)
  eventType      NotificationEventType @default(NEW_LEAD) @map("event_type")
  entityType     String?               @map("entity_type")
  entityId       String?               @map("entity_id")
  metadata       Json?                 @default("{}")
  isRead         Boolean               @default(false) @map("is_read")
  readAt         DateTime?             @map("read_at")
  deliveryStatus String                @default("SENT") @map("delivery_status")
  createdAt      DateTime              @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  smsEnabled      Boolean  @default(false) @map("sms_enabled")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  orderUpdates    Boolean  @default(true) @map("order_updates")
  marketingAlerts Boolean  @default(false) @map("marketing_alerts")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  action        String
  entityTable   String   @map("entity_table")
  entityId      String   @map("entity_id")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
