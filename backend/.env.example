# Application Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Brand Configuration Defaults
BRAND_NAME="KHADIJA-TUL-QUBRAH BY Meer&Mus"
BRAND_PRIMARY_DISPLAY="KHADIJA-TUL-QUBRAH"
BRAND_SECONDARY_SIGNATURE="BY Meer&Mus"
BRAND_PRIMARY_COLOR="#072A20"
BRAND_SECONDARY_COLOR="#C5A059"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://ktq_admin:ktq_secure_password_2026@localhost:5432/khadija_tul_qubrah_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-khadija-tul-qubrah-2026-luxury-couture"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-khadija-tul-qubrah-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_secure_password_2026"
S3_BUCKET_NAME="khadijatulqubrah-media"
S3_FORCE_PATH_STYLE=true

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"
